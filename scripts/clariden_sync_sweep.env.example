# Copy this file outside the Git checkout, replace every <...> value, and keep the checkout clean.
MIRA_PROJECT_DIR="<shared>/mira"
MIRA_PYTHON="<shared>/mira/.pixi/envs/default/bin/python"
CS1K_RELEASE_DIR="<shared>/CounterStrike-1K"
CS1K_RELEASE_PYTHON="<shared>/CounterStrike-1K/.venv/bin/python"

CS1K_DATASET_DIR="<shared>/data/cs1k-360p"
CS1K_MANIFEST_PATH="<shared>/data/cs1k-360p/manifest_dust2_confirmatory_spatial_v1.parquet"
CS1K_CONFIRMATORY_SPLIT_PROVENANCE="<shared>/data/cs1k-360p/manifest_dust2_confirmatory_spatial_v1.provenance.json"
CS1K_CODEC_CHECKPOINT="<shared>/checkpoints/codec/checkpoint-18000/checkpoint.pth"
CS1K_SINGLE_CHECKPOINT="<shared>/checkpoints/mira-single-step15000/checkpoint.pth"
CS1K_OUTPUT_ROOT="<shared>/runs/mira_dust2_sync_fixed10k_v1"

CS1K_TRAIN_STEPS=10000
CS1K_ARM_HOURS=4
CS1K_TRAINING_SEEDS="28 29 30"
CS1K_EVENT_FEATURE_SEED=37
CS1K_EVENT_PROBE_SEEDS="17 29 43"
CS1K_EVENT_BOOTSTRAP_SAMPLES=10000

CS1K_SLURM_ACCOUNT="<account>"
CS1K_GH200_PARTITION="<gh200-partition>"
CS1K_TRAINING_TIME=12:00:00
CS1K_EVENT_TIME=04:00:00
CS1K_FINALIZE_TIME=00:30:00

# Optional site-specific flags, for example a reservation, constraint, or uenv.
CS1K_TRAIN_SBATCH_ARGS=""
CS1K_AUX_SBATCH_ARGS=""
